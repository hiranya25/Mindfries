# Supabase project (shared with candidate/frontend and internal-admin/frontend
# — see /ARCHITECTURE.md). Anon key is used only for end-user auth (sign in/
# out, password reset); everything else goes through the service-role key,
# server-side only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — powers candidate/teammate invite emails and password-reset links.
# Without these, invites still write to the database, they just skip sending
# (see lib/mailer.ts's mailerReady() gate).
RESEND_API_KEY=
RESEND_FROM=

# This app's own public URL — used to build the login link in teammate
# invite emails and the redirect target for password-reset links.
NEXT_PUBLIC_APP_URL=

# The candidate app's general entry URL, linked from candidate invite emails.
# Not a per-assessment deep link: candidate/frontend has no per-assessment
# route yet (its entry flow is hardcoded to a single template — see
# candidate/frontend/src/app/onboarding/actions.ts).
NEXT_PUBLIC_CANDIDATE_APP_URL=
